{
  "name": "poro-klon",
  "version": "0.1.0",
  "private": true,
  "description": "Porofessor-Klon: League of Legends Companion App (Lobby-Analyse, Tags, Overlay)",
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @poro/desktop dev",
    "build": "pnpm --filter @poro/desktop build",
    "dist:win": "pnpm --filter @poro/desktop dist:win",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
